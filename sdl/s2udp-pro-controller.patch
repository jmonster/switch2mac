+/* Do not let a closed, renamed or expired joystick keep rumbling a slot
+ * that might subsequently be owned by another controller. */
+static void S2UDP_StopEffects(S2UDP_Slot *slot)
+{
+    if (slot->rumble_strong || slot->rumble_weak) {
+        slot->rumble_strong = slot->rumble_weak = 0;
+        S2UDP_SendRumble(slot);
+    }
+    slot->sensors_enabled = false;
+}
+
 static void S2UDP_EmitState(SDL_Joystick *joystick, S2UDP_Slot *slot);
 
 /* Every received state reaches an open joystick before the next is read.
@@ -150,6 +166,12 @@ static void S2UDP_PumpSlot(S2UDP_Slot *slot)
             slot->ry = read_f32(buf + 24);
