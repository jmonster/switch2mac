 static Sint16 S2UDP_AxisFromFloat(float value)
 {
+    if (SDL_isnan(value) || SDL_isinf(value)) return 0;
     if (value < -1.0f) value = -1.0f;
     if (value > 1.0f) value = 1.0f;
     return (Sint16)(value * 32767.0f);
@@ -435,6 +474,23 @@ static void S2UDP_EmitState(SDL_Joystick *joystick, S2UDP_Slot *slot)
     SDL_SendJoystickAxis(timestamp, joystick, 4, S2UDP_AxisFromTrigger(slot->lt));
     SDL_SendJoystickAxis(timestamp, joystick, 5, S2UDP_AxisFromTrigger(slot->rt));
 
+    if (slot->sensors_enabled && slot->sensor_generation != slot->state_generation) {
+        // Match the pinned SDL Switch 2 driver's nominal scale and Pro frame:
+        // raw (X,Y,Z) -> SDL (X,Z,-Y), radians/s and m/s^2 respectively.
+        // No bias calibration or firmware-dependent sensitivity detection is
+        // claimed: the legacy UDP format carries neither calibration nor IMU time.
+        const float gyro_scale = 34.8f / 32767.0f;
+        const float accel_scale = 9.80665f * 8.0f / 32767.0f;
+        const float gyro[3] = { slot->gyro[0] * gyro_scale,
+            slot->gyro[2] * gyro_scale, -slot->gyro[1] * gyro_scale };
+        const float accel[3] = { slot->accel[0] * accel_scale,
+            slot->accel[2] * accel_scale, -slot->accel[1] * accel_scale };
+        SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_GYRO,
+                               slot->sensor_timestamp, gyro, 3);
+        SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_ACCEL,
+                               slot->sensor_timestamp, accel, 3);
+        slot->sensor_generation = slot->state_generation;
+    }
 }
 
