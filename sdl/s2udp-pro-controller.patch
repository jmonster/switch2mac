+            for (int i = 0; i < 3; ++i) {
+                slot->gyro[i] = read_s16(buf + 32 + i * 2);
+                slot->accel[i] = read_s16(buf + 38 + i * 2);
+            }
+            ++slot->state_generation;
+            slot->sensor_timestamp = SDL_GetTicksNS();
             slot->last_state_ms = now;
             if (slot->present && slot->joystick) {
