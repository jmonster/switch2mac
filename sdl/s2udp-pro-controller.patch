 static bool S2UDP_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
 {
-    return SDL_Unsupported();
+    S2UDP_Slot *slot = (S2UDP_Slot *)joystick->hwdata;
+    if (!slot || slot->joystick != joystick || !slot->present) {
+        return SDL_Unsupported();
+    }
+    slot->sensors_enabled = enabled;
+    // Do not replay an old sample when enabling or reopening a gamepad.
